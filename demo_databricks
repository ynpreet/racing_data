✅ 3. Auto Loader Function (Reusable)

from pyspark.sql.functions import input_file_name, current_timestamp, lit

def load_lob(lob_name, lob_path):
    
    source_path = f"{base_path}{lob_path}"
    checkpoint_path = f"{base_path}checkpoints/{lob_name}/"
    schema_path = f"{base_path}schemas/{lob_name}/"
    
    target_table = f"{catalog}.{schema}.{lob_name}"

    df = (
        spark.readStream
        .format("cloudFiles")
        .option("cloudFiles.format", "text")   # since files are .txt
        .option("cloudFiles.schemaLocation", schema_path)
        .option("cloudFiles.inferColumnTypes", "true")
        .load(source_path)
    )

    # Add utility columns
    df = df.withColumn("source_file", input_file_name()) \
           .withColumn("ingestion_ts", current_timestamp()) \
           .withColumn("env", lit(env))

    # Write to Delta
    (
        df.writeStream
        .format("delta")
        .option("checkpointLocation", checkpoint_path)
        .option("mergeSchema", "true")
        .outputMode("append")
        .trigger(once=True)   # batch-style incremental
        .toTable(target_table)
    )


⸻

